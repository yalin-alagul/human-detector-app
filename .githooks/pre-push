#!/usr/bin/env bash
#
# Pre-push gate: a push will not go through unless the tests pass.
# Enable once per clone with:  make hooks
#
set -euo pipefail

# Command Line Tools have no XCTest or xcodebuild; use Xcode when it's there.
if [[ -z "${DEVELOPER_DIR:-}" && "$(xcode-select -p 2>/dev/null)" == *CommandLineTools* \
      && -d /Applications/Xcode.app/Contents/Developer ]]; then
  export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
fi

echo "▶ pre-push: swift test"
swift test

if command -v xcodegen >/dev/null 2>&1; then
  echo "▶ pre-push: xcodegen generate"
  xcodegen generate >/dev/null
  echo "▶ pre-push: xcodebuild build"
  xcodebuild \
    -project HumanDetector.xcodeproj \
    -scheme HumanDetector \
    -configuration Debug \
    -destination 'platform=macOS' \
    -derivedDataPath build/DerivedData \
    CODE_SIGNING_ALLOWED=NO \
    build >/dev/null
else
  echo "⚠ xcodegen not found — skipping app build (brew install xcodegen)"
fi

echo "✔ pre-push checks passed"
